global_defs {
    script_user root
    enable_script_security
}

vrrp_script chk_scmc {
    script "systemctl is-active ks-scmc-controller && systemctl is-active mysqld"
    interval 2
}

vrrp_instance VI_1 {
    interface {{ cluster.virtual_ip_nic }}
    state BACKUP
    virtual_router_id 33
    priority 100
    advert_int 1

    authentication {
        auth_type PASS
        auth_pass password
    }

    virtual_ipaddress {
        {{ cluster.virtual_ip }}
    }

    track_script {
        chk_scmc
    }
}