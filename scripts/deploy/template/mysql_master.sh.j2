#!/bin/bash

# mysql 用户名 root 密码 kylin.2023 依据自己的用户名
# 密码进行修改

mysql -uroot -p'{{ mysql.root_password }}' -e "STOP SLAVE;"
mysql -uroot -p'{{ mysql.root_password }}' -e "RESET SLAVE ALL;"
mysql -uroot -p'{{ mysql.root_password }}' -e "SET GLOBAL read_only=0;"

echo "$(date) - MySQL promoted to Master" >> /var/log/keepalived_mysql.log

