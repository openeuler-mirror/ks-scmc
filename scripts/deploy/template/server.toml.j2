[log]
basedir = "/var/log/ks-scmc"
level   = "debug"
stdout  = false

[tls]
enable = false
ca = ""
server_cert = ""
server_key = ""

[agent]
host = "0.0.0.0"
port = 10051

[controller]
host = "0.0.0.0"
port = 10050
super-user = true
virtual-if = "{{ cluster.virtual_ip_nic | default('') }}"
virtual-ip = "{{ cluster.virtual_ip | default('') }}"

[mysql]
addr = "{{ lookup('env', 'cluster.virtual_ip') | default('127.0.0.1', true) }}:3306"
user = "ks-scmc"
password = "{{ MYSQL_SCMC_PASSWORD_EN.stderr }}"
db = "ks-scmc"

[sqlite]
path = "/var/lib/ks-scmc/data.db"

[cadvisor]
addr = "127.0.0.1:8080"

[influxdb]
addr = "127.0.0.1:8086"

[registry]
secure = false
addr = "127.0.0.1:5000"
