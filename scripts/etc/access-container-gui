#!/usr/bin/bash
set -e
CONTAINER_NAME="$1"
CONTAINER_CMD=${2:-'/bin/bash'}

if [[ -z $CONTAINER_NAME ]]; then
    echo "Container ID/name] not provided" >&2
    exit 1
fi

BASE_DIR="/var/lib/ks-scmc/containers"
SOCK_DIR=${BASE_DIR}/${CONTAINER_NAME}/socket
HOSTNAME=$(docker inspect -f '{{ .Config.Hostname }}' ${CONTAINER_NAME})

# Get the DISPLAY slot
DISPLAY_NUMBER=$(echo $DISPLAY | cut -d. -f1 | cut -d: -f2)
AUTH_FILE=${BASE_DIR}/${CONTAINER_NAME}/xauth/${DISPLAY_NUMBER}/Xauthority

# X11 auth permission
SUDOER_HOME=$(getent passwd ${SUDO_USER} | cut -d: -f6)
AUTH_COOKIE=$(HOME=${SUDOER_HOME} xauth list | grep "^$(hostname)/unix:${DISPLAY_NUMBER} " | awk '{print $3}')
if [[ ! -d "${AUTH_FILE}" ]]; then
    mkdir ${BASE_DIR}/${CONTAINER_NAME}/xauth/${DISPLAY_NUMBER}/ -p
fi
>${AUTH_FILE}

xauth -f ${AUTH_FILE} add ${HOSTNAME}/unix:${DISPLAY_NUMBER} MIT-MAGIC-COOKIE-1 ${AUTH_COOKIE}

# Proxy with the :0 DISPLAY
socat UNIX-LISTEN:${SOCK_DIR}/X${DISPLAY_NUMBER},fork TCP4:localhost:60${DISPLAY_NUMBER} 2>/dev/null &

cat > ${BASE_DIR}/config.json << EOF
{
    "HttpHeaders": {
        "Authz-User": "KS-SCMC-SERVICE"
    }
}
EOF
export DOCKER_CONFIG=${BASE_DIR}

# make sure container is running
IS_RUNNING=$(docker inspect -f '{{ .State.Running }}' ${CONTAINER_NAME})
if [[ "${IS_RUNNING}" == "false" ]]; then
    docker start ${CONTAINER_NAME}
fi

docker exec -it -e DISPLAY=:${DISPLAY_NUMBER}.0 -e XAUTHORITY=/tmp/.xauth/${DISPLAY_NUMBER}/Xauthority ${CONTAINER_NAME} ${CONTAINER_CMD}
